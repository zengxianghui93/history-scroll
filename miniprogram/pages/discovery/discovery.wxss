page { background: #F8F1E4; }
.page { padding: 40rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); color: #433B30; }
button::after { border: 0; }
.eyebrow { color: #92704D; font-size: 22rpx; letter-spacing: 4rpx; }
.title { font-size: 52rpx; font-weight: 800; margin: 14rpx 0; letter-spacing: 2rpx; }
.subtitle { color: #8A7B6E; font-size: 26rpx; }
.invitation { padding: 16rpx 20rpx; margin-top: 20rpx; background: #E8EFDF; color: #4C6940; border-radius: 12rpx; font-size: 24rpx; }
.letter { display: flex; margin: 32rpx 0; padding: 24rpx; background: #FFFDF8; border-radius: 20rpx; }
.cat { font-size: 48rpx; margin-right: 18rpx; }
.letter-content { flex: 1; }
.letter-label, .section-label { font-size: 22rpx; color: #A16B36; font-weight: 600; }
.letter-text { font-size: 27rpx; line-height: 1.8; margin-top: 8rpx; }
.map-header { display: flex; justify-content: space-between; font-size: 26rpx; font-weight: 600; margin: 0 6rpx 16rpx; }
.map-progress { color: #8A7B6E; font-size: 23rpx; font-weight: 400; }
.map { height: 760rpx; position: relative; overflow: hidden; border-radius: 160rpx 160rpx 24rpx 24rpx; border: 2rpx solid #D9CEB8; background: #E9E4D4; }
.map-texture { position: absolute; inset: 0; opacity: .6; background-image: repeating-linear-gradient(0deg, transparent, transparent 88rpx, #FFF9EC 88rpx, #FFF9EC 100rpx), repeating-linear-gradient(90deg, transparent, transparent 100rpx, #FFF9EC 100rpx, #FFF9EC 112rpx); }
.axis-line { position: absolute; left: calc(50% - 3rpx); top: 15%; bottom: 17%; width: 6rpx; background: #B86A3E; opacity: 0; transition: opacity .8s; }
.connected .axis-line { opacity: 1; }
.compass { position: absolute; right: 35rpx; top: 32rpx; color: #6B7257; font-size: 24rpx; }
.map-caption { position: absolute; bottom: 22rpx; left: 0; width: 100%; text-align: center; color: #8B826F; font-size: 20rpx; }
.landmark { position: absolute; transform: translate(-50%, -50%); width: 146rpx; padding: 12rpx 0; margin: 0; line-height: 1.5; background: transparent; border-radius: 18rpx; overflow: visible; }
.building { width: 82rpx; margin: 0 auto; height: 62rpx; position: relative; }
.roof { position: absolute; top: 0; left: -7rpx; width: 96rpx; height: 22rpx; background: #967953; border-radius: 60% 60% 10% 10%; border-bottom: 6rpx solid #705C40; }
.walls { position: absolute; bottom: 0; width: 82rpx; height: 34rpx; background: #B68B70; border-bottom: 6rpx solid #D1BA95; }
.door { width: 17rpx; height: 26rpx; background: #6F5A49; margin: 8rpx auto 0; border-radius: 12rpx 12rpx 0 0; }
.tower .building { height: 82rpx; }
.tower .walls { height: 53rpx; }
.temple .roof { border-radius: 80% 80% 0 0; background: #64808A; height: 35rpx; top: -10rpx; border-bottom-color: #4E6871; }
.water .building { border-radius: 50%; background: #A9C8BF; height: 62rpx; width: 105rpx; border: 6rpx solid #D1DDD0; box-sizing: border-box; }
.water .roof, .water .walls { display: none; }
.landmark-name { font-size: 24rpx; margin-top: 10rpx; display: inline-block; color: #645847; background: #F7F0DF; border-radius: 8rpx; padding: 3rpx 10rpx; }
.found .roof { background: #D5A343; border-bottom-color: #A97632; }
.found .walls { background: #AF5440; }
.found .landmark-name { color: #FFFDF8; background: #8B4D32; }
.clue-card, .reveal { margin-top: 24rpx; background: #FFFDF8; padding: 28rpx; border-radius: 20rpx; }
.clue-text { font-size: 29rpx; line-height: 1.8; margin-top: 12rpx; }
.gentle { font-size: 22rpx; color: #8A7B6E; margin-top: 18rpx; line-height: 1.6; }
.choice { background: #F5EDDC; border: 2rpx solid #DCC8A8; text-align: left; font-size: 26rpx; line-height: 1.6; padding: 20rpx; margin-top: 18rpx; color: #5C4935; border-radius: 14rpx; }
.choice-feedback { color: #8B633D; font-size: 25rpx; line-height: 1.8; margin-top: 18rpx; }
.reveal-title { font-size: 34rpx; font-weight: 700; margin: 16rpx 0; }
.knowledge { font-size: 28rpx; line-height: 1.9; }
.extra { margin-top: 16rpx; color: #8A7B6E; font-size: 24rpx; }
.source { color: #6B7B55; font-size: 21rpx; text-align: left; padding: 18rpx 0; background: transparent; line-height: 1.7; }
.bookmark { position: relative; text-align: center; margin: 24rpx auto 30rpx; width: 84%; box-sizing: border-box; padding: 36rpx 24rpx; border: 2rpx solid #C6A573; background: linear-gradient(150deg, #FAEDD0, #F6E3B8); border-radius: 6rpx 6rpx 50rpx 6rpx; }
.bookmark-seal { display: inline-block; border: 2rpx solid #AB6047; color: #AB6047; border-radius: 50%; font-size: 20rpx; padding: 12rpx; line-height: 1.2; transform: rotate(-10deg); }
.bookmark-title { font-size: 38rpx; font-weight: 700; letter-spacing: 6rpx; margin: 20rpx 0; }
.bookmark-route { color: #9B613E; font-size: 24rpx; line-height: 1.4; }
.bookmark-caption { font-size: 23rpx; margin-top: 24rpx; color: #7E684B; }
.bookmark-status { font-size: 21rpx; color: #947344; margin-top: 16rpx; }
.collected { box-shadow: 0 8rpx 28rpx #CDB99455; }
.primary, .share-button { background: #AD6240; color: #FFFDF8; border-radius: 14rpx; font-size: 28rpx; line-height: 1.6; padding: 22rpx 16rpx; }
.primary[disabled] { color: #697B54; background: #E8EDDF; }
.text-button { color: #7B6A51; background: transparent; font-size: 25rpx; padding: 22rpx 0 0; line-height: 1.8; }
.share-card { padding: 28rpx; background: #E7ECDF; border-radius: 20rpx; margin-top: 28rpx; }
.share-title { font-size: 29rpx; font-weight: 700; color: #465A3D; }
.share-description { font-size: 24rpx; line-height: 1.8; color: #6B775F; margin: 12rpx 0 22rpx; }
.share-button { background: #607A50; }
.outcome-note { margin: 18rpx 0; padding: 14rpx 18rpx; background: #EBEFDF; color: #6A7D53; font-size: 23rpx; line-height: 1.8; border-radius: 10rpx; }
