@import "../../styles/beijing-stories.wxss";
@import "../../styles/discovery-motion.wxss";
page { background: #F7F1E3; color: #443E32; }
.page button::after { border: 0; }
.page { padding: 36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); }
.eyebrow { color: #76654D; font-size: 23rpx; letter-spacing: 2rpx; }
.title { font-family: "Songti SC", "SimSun", serif; font-size: 58rpx; font-weight: 700; margin: 12rpx 0 20rpx; }
.intro, .body { font-size: 28rpx; line-height: 1.8; }
.intro { color: #6E604B; margin-bottom: 34rpx; }
.section { padding: 24rpx 0; border-top: 1rpx solid #DED3BB; }
.section-title { color: #526A42; font-size: 31rpx; font-weight: 700; margin-bottom: 12rpx; }
.body + .body { margin-top: 12rpx; }
