@import "../../reading/theme.wxss";
page{background:#f5f2e9}
.home{padding:22rpx 32rpx 32rpx;min-height:0;background:radial-gradient(ellipse at 90% 10%,#e8eadd88,transparent 60%)}
.home-header{display:flex;justify-content:space-between;align-items:center;margin:8rpx 0 32rpx;gap:16rpx}.eyebrow{font-size:22rpx;color:#969181;letter-spacing:3rpx;margin-bottom:12rpx}.home .heading{font-size:44rpx;font-weight:500;letter-spacing:2rpx;color:#33473e}.shelf-link{flex-shrink:0;margin:20rpx 0 0;padding:12rpx 0 12rpx 20rpx;background:transparent;color:#627366;font-size:24rpx;line-height:1.5}.shelf-link text{padding-left:6rpx}
.reading-card{padding:28rpx;background:#fffcf5;border:1rpx solid #e8e2d5;border-radius:28rpx;box-shadow:0 14rpx 40rpx #534a3310;overflow:hidden}.card-caption{display:flex;align-items:center;color:#627364;font-size:22rpx;letter-spacing:2rpx;margin-bottom:28rpx}.caption-dot{width:10rpx;height:10rpx;border-radius:50%;background:#899e77;margin-right:10rpx}.private-label{margin-left:auto;color:#aaa28f;font-size:20rpx;letter-spacing:1rpx}.book-intro{display:flex;gap:28rpx;align-items:center}.book-art{position:relative;flex-shrink:0;width:176rpx;height:246rpx;border-radius:4rpx 10rpx 10rpx 4rpx;box-shadow:5rpx 9rpx 13rpx #75624130;overflow:hidden}.book-art image{width:100%;height:100%}.book-art-title{position:absolute;top:27rpx;left:30rpx;font:28rpx/1.5 serif;letter-spacing:5rpx;color:#4b5745}.book-spine{position:absolute;top:0;bottom:0;left:7rpx;width:6rpx;border-left:1rpx solid #a3916333;background:#fff3}.book-info{flex:1;min-width:0}.book-title{font:500 34rpx/1.5 "Songti SC",serif;color:#344438;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;word-break:break-all}.book-author{font-size:22rpx;line-height:1.6;color:#8a8878;margin-top:10rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.progress-label{display:flex;flex-wrap:wrap;justify-content:space-between;gap:6rpx;margin-top:24rpx;align-items:baseline;font-size:19rpx;color:#999180}.progress-label>text:first-child{color:#67775e}.percent{font-size:30rpx;margin:0 3rpx;font-family:Georgia,serif}.home .progress{height:5rpx;margin:10rpx 0 0;background:#e9e6d9}.home .progress view{background:#8c9a71;border-radius:5rpx}
.resume-note{margin:30rpx 0 24rpx;padding:22rpx 22rpx 20rpx;border-radius:14rpx;background:#f5f2e9;border-left:3rpx solid #d5d9c5}.resume-heading{display:flex;gap:16rpx;align-items:center;color:#9b917d;font-size:20rpx}.chapter-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:right;color:#7f8475}.excerpt{font:26rpx/1.85 "Songti SC",serif;color:#626557;margin-top:12rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;word-break:break-all}
.home .read-action{box-sizing:border-box;display:flex;align-items:center;justify-content:center;position:relative;width:100%;max-width:none;margin:0;padding:24rpx 50rpx;border-radius:15rpx;background:linear-gradient(115deg,#526d58,#354f42);color:#fffaf0;font-size:29rpx;line-height:1.5;letter-spacing:3rpx;box-shadow:0 6rpx 12rpx #40584b18}.action-arrow{position:absolute;right:28rpx;font-size:32rpx;opacity:.7}.card-footer{text-align:center;color:#a39c8b;font-size:20rpx;letter-spacing:1rpx;margin-top:18rpx}.section-heading{display:flex;justify-content:space-between;align-items:center;margin:32rpx 2rpx 18rpx;font-size:27rpx;color:#4e5c4d}.week-caption{font-size:20rpx;color:#9b9586}.week-card{display:flex;align-items:center;padding:24rpx 8rpx;border-top:1rpx solid #dfdfd0;border-bottom:1rpx solid #dfdfd0}.stat{flex:1;padding:0 18rpx}.stat+.stat{border-left:1rpx solid #dfdfd0}.stat-number{font:40rpx/1.2 Georgia,serif;color:#566c52}.stat-unit{font-size:20rpx;color:#919281;margin-left:8rpx}.stat-label{display:block;font-size:20rpx;color:#9b9687;margin-top:9rpx}.home .journal-link{background:transparent;padding:0 16rpx;margin:0;display:flex;flex-direction:column;align-items:center;gap:8rpx;font-size:20rpx;line-height:1.5;color:#8e7562;flex-shrink:0}.journal-icon{font:26rpx/1.3 serif;border:3rpx double #b49c7b;border-radius:3rpx;padding:3rpx 7rpx;transform:rotate(-6deg)}.home .sync-button{display:block;width:100%;max-width:none;font-size:19rpx;line-height:1.6;color:#a5a091;background:transparent;padding:22rpx 0 6rpx;margin:0}.sync-button text{margin-left:8rpx}.home .invitation{display:flex;align-items:center;gap:16rpx;text-align:left;width:100%;max-width:none;background:#edeede;border-color:#e0e3cf;color:#697458;padding:20rpx;font-size:23rpx}.invitation-copy{flex:1}.tomato{font-size:36rpx}.invitation .tiny{margin-top:3rpx;font-size:20rpx}.empty-card{padding:0 28rpx 12rpx}.empty-art{height:300rpx;margin:0 -28rpx;position:relative;overflow:hidden}.empty-art image{width:100%;height:100%;opacity:.85}.empty-art-copy{position:absolute;top:32rpx;left:30rpx;color:#485b42;font:32rpx/1.7 serif}.empty-title{font:32rpx/1.6 serif;text-align:center;margin-top:26rpx}.empty-description{font-size:23rpx;color:#97907e;text-align:center;margin:10rpx 0 24rpx}.home .privacy{font-size:19rpx;text-align:center;margin:18rpx 0 8rpx}.home .list-row{gap:24rpx}.list-row>text:first-child{flex:1;min-width:0}.list-row .tiny{flex-shrink:0}

.home .restore-link{margin:18rpx 0 0;width:100%;max-width:none;background:transparent;font-size:22rpx;color:#728065;line-height:1.8;padding:8rpx 0}

.shelf-mask{background:#25392e66}.shelf-sheet{width:100%;box-sizing:border-box;max-height:82vh;display:flex;flex-direction:column;background:#f8f5ed;border-radius:36rpx 36rpx 0 0;padding:14rpx 28rpx 0;box-shadow:0 -12rpx 50rpx #263d2914}.sheet-handle{width:64rpx;height:7rpx;background:#d9dacb;border-radius:10rpx;margin:0 auto 26rpx;flex-shrink:0}.shelf-sheet-heading{display:flex;justify-content:space-between;align-items:center;padding:0 8rpx 24rpx;flex-shrink:0;gap:20rpx}.shelf-sheet-title{font:34rpx/1.5 "Songti SC",serif;color:#354e3b}.shelf-sheet-subtitle{font-size:21rpx;color:#9b9786;margin-top:8rpx}.shelf-close{margin:0;padding:0;width:58rpx;height:58rpx;line-height:54rpx;flex-shrink:0;min-width:0;font-size:36rpx;border-radius:50%;background:#eeece0;color:#8a8f7a}.shelf-book-list{max-height:48vh;min-height:0}.shelf-book{display:flex;gap:20rpx;align-items:center;padding:22rpx 18rpx;background:#fffcf5;border:1rpx solid #e9e4d6;border-radius:18rpx;margin-bottom:14rpx;box-sizing:border-box}.shelf-book.is-current{background:#eff2e5;border-color:#cbd5bb}.shelf-book-cover{position:relative;width:76rpx;height:106rpx;flex-shrink:0;overflow:hidden;border-radius:3rpx 6rpx 6rpx 3rpx;box-shadow:3rpx 4rpx 8rpx #6d623b22}.shelf-book-cover image{width:100%;height:100%}.shelf-book-cover text{position:absolute;top:12rpx;left:16rpx;font:22rpx serif;color:#647150}.shelf-book-details{flex:1;min-width:0}.shelf-book-title{font:27rpx/1.5 "Songti SC",serif;color:#3d4d3b;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;word-break:break-all}.shelf-book-author{font-size:20rpx;color:#99917e;margin-top:5rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.shelf-book-meta{display:flex;gap:16rpx;align-items:center;margin-top:12rpx;font-size:20rpx;color:#959680}.current-badge{color:#607d51;background:#dde6ce;border-radius:6rpx;padding:2rpx 10rpx;font-size:18rpx}.shelf-book-check{flex-shrink:0;color:#8f9d7d;font-size:28rpx;width:30rpx;text-align:center}.shelf-sheet-footer{padding:22rpx 8rpx calc(24rpx + env(safe-area-inset-bottom));flex-shrink:0;border-top:1rpx solid #e8e3d6}.shelf-import{margin:0;width:100%;max-width:none;padding:21rpx 20rpx;line-height:1.5;font-size:27rpx;background:#45624d;color:#fffaf0;border-radius:16rpx}.shelf-sheet-footer>view{text-align:center;font-size:19rpx;color:#a09b88;margin-top:15rpx}
