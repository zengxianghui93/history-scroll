@import "../../reading/theme.wxss";page{height:100%;background:#e9e5da}.journal-page{height:100vh;box-sizing:border-box;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;background:#e9e5da}.journal-top{display:flex;justify-content:space-between;align-items:center;padding:0 8rpx 24rpx;flex-shrink:0}.journal-name{font:30rpx/1.6 serif;max-width:550rpx;white-space:nowrap;text-overflow:ellipsis;overflow:hidden}.book-swiper{flex:1;min-height:0;width:100%}.paper{position:relative;box-sizing:border-box;height:calc(100% - 20rpx);margin:0 12rpx 20rpx 4rpx;padding:42rpx 40rpx 60rpx 54rpx;border:1rpx solid #cabb9e;border-radius:4rpx 16rpx 16rpx 4rpx;background:repeating-linear-gradient(4deg,#fff4 0,#fff4 1rpx,transparent 2rpx,transparent 6rpx),#f7edda;box-shadow:5rpx 5rpx 0 -1rpx #e0d4bb,9rpx 9rpx 0 -3rpx #c6b99d;overflow:hidden;display:flex;flex-direction:column}.spine{position:absolute;top:0;bottom:0;left:12rpx;width:16rpx;border-right:1rpx solid #b9a5825e;background:#bda87b16;z-index:2}.spine::after{content:"";position:absolute;left:6rpx;top:8%;height:84%;border-left:3rpx dashed #ad9874}.cover-art{position:absolute;inset:0;width:100%;height:100%}.cover-overlay{position:absolute;inset:0;background:linear-gradient(#f9efde77,transparent 65%,#f9efde)}.paper-brand{font-size:22rpx;letter-spacing:4rpx;color:#8c7d65;position:relative}.paper-title{position:relative;font:600 44rpx/1.6 serif;margin:32rpx 0;color:#3d493a;word-break:break-all}.paper-cover .paper-title{font-size:54rpx}.paper-bottom{position:absolute;bottom:100rpx;left:54rpx;right:40rpx;font:28rpx/1.8 serif}.paper-time{font:48rpx serif;color:#9c5c43;margin-bottom:30rpx}.paper-time text{font:23rpx sans-serif}.note-scroll{flex:1;min-height:0;margin-bottom:75rpx}.paper-note{font:30rpx/2 serif;white-space:pre-wrap;color:#716953}.paper-seal{position:absolute;right:36rpx;bottom:43rpx;border:5rpx double #ac634a;padding:12rpx;color:#a25942;font:30rpx serif;transform:rotate(-6deg)}.folio{position:absolute;bottom:15rpx;left:0;right:0;text-align:center;font-size:19rpx;color:#a09580}.share-options{display:flex;align-items:center;justify-content:center;font-size:22rpx;color:#7d7d6e;padding:16rpx 0;flex-shrink:0}.share-options checkbox{transform:scale(.7)}.share-note{text-align:center;font-size:19rpx;margin-top:10rpx}.save{text-align:center}.export-canvas{position:fixed;left:-2000px;top:0;width:750px;height:1100px}

