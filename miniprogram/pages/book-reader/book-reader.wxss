@import "../../reading/theme.wxss";
page{height:100%;overflow:hidden}.reader{height:100vh;box-sizing:border-box;padding:0 26px calc(14px + env(safe-area-inset-bottom));display:flex;flex-direction:column;background:#f8f5ed;color:#343b32;position:relative}.reader.dark{background:#242c27;color:#dbdfd6;--paper:#242c27;--line:#465147;--muted:#9da598}.reader-top{height:40px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-shrink:0;font-size:11px;color:#969587;border-bottom:1px solid #9088751a}.reader-top text{flex:1;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;letter-spacing:.5px}.reader-top button{flex-shrink:0;background:transparent;color:inherit;margin:0;padding:8px 0 8px 12px;font:18px/1.2 Georgia,serif;min-width:36px}.chapter-header{display:flex;align-items:baseline;justify-content:space-between;gap:16px;padding:20px 0 19px;flex-shrink:0}.chapter-label{font-size:10px;color:#9b927f;flex-shrink:0;letter-spacing:1px}.reader-title{font:500 20px/1.4 "Songti SC",serif;white-space:nowrap;text-overflow:ellipsis;overflow:hidden;color:inherit}.reading-area{flex:1;min-height:0;white-space:pre-wrap;word-break:break-all;font-family:"Songti SC","SimSun",serif;overflow:hidden;letter-spacing:0}.reader-foot{display:flex;justify-content:space-between;align-items:center;gap:12px;font-size:10px;color:#999a8e;padding:14px 0 0;flex-shrink:0;line-height:1.5}.reader-foot text:last-child{flex-shrink:0;font-variant-numeric:tabular-nums}.reader-tools{position:absolute;bottom:0;left:0;right:0;background:var(--paper);border-top:1px solid var(--line);border-radius:20px 20px 0 0;padding:14px 26px calc(16px + env(safe-area-inset-bottom));display:flex;justify-content:space-around;box-shadow:0 -8px 24px #252e2610}.reader-tools button{background:transparent;color:inherit;font-size:25px;line-height:1.4;flex:1;margin:0;padding:4px 0}.reader-tools text{display:block;font-size:12px;margin-top:5px;color:var(--muted)}.gesture-help{font-size:23rpx;color:var(--muted);line-height:1.8;padding-bottom:15rpx}.turning{animation:page-turn .18s ease-out}.current{color:#a85c46}.dark .sheet{color:#dbdfd6}@keyframes page-turn{from{transform:translateX(5px);opacity:.75}to{transform:none;opacity:1}}

/* 固定正文以遮罩揭页，避免透视变形和整页明暗变化。 */
.page-stage{flex:1;min-height:0;position:relative;overflow:hidden;background:var(--paper);font-family:"Songti SC","SimSun",serif}.page-stage .reading-area{height:100%;position:relative}.turn-sheet{position:absolute;inset:0;overflow:hidden;z-index:2;pointer-events:none;background:var(--paper);animation:sheet-reveal 320ms cubic-bezier(.25,.7,.3,1) both;will-change:transform}.turn-sheet .paper-text{height:100%;white-space:pre-wrap;word-break:break-all;overflow:hidden;animation:text-stay 320ms cubic-bezier(.25,.7,.3,1) both;will-change:transform}.turn-sheet.previous,.turn-sheet.previous .paper-text{animation-direction:reverse}.paper-fold{position:absolute;right:0;top:0;bottom:0;width:18px;background:linear-gradient(90deg,transparent,#dfd6c433 35%,#fff9 72%,#b0a48e33);border-right:1px solid #a597791f;animation:fold-edge 320ms ease both}.dark .paper-fold{background:linear-gradient(90deg,transparent,#ffffff08 65%,#0002);border-color:#0002}.turn-sheet.previous .paper-fold{animation-direction:reverse}
@keyframes sheet-reveal{from{transform:translate3d(0,0,0)}to{transform:translate3d(-100%,0,0)}}@keyframes text-stay{from{transform:translate3d(0,0,0)}to{transform:translate3d(100%,0,0)}}@keyframes fold-edge{0%{opacity:0}18%{opacity:1}85%{opacity:1}100%{opacity:0}}

.book-image{display:block;width:100%;height:100%;background:var(--paper)}

.page-stage .reading-area,.turn-sheet .paper-text{white-space:pre;word-break:normal;overflow-wrap:normal;font-kerning:none;font-variant-ligatures:none;tab-size:4}
