<view class="screen hall">
 <view class="hall-heading"><view class="eyebrow">各自翻书，也有同行的人</view><view class="heading">同读大厅</view></view>
 <view class="summary-card"><view class="summary-caption">我的本周 <text>一点点，也在向前</text></view><view class="summary-main"><view><text class="summary-number">{{stats.minutes}}</text><text class="summary-unit">分钟</text><view class="summary-label">留给阅读的时间</view></view><view class="summary-days"><text>{{stats.days}}</text> 天<view class="summary-label">翻开过书</view></view><view class="book-decoration"><view/><view/><text>读</text></view></view><view class="summary-bottom">本机阅读积累 · 联网同步后计入大厅</view></view>
 <view class="tabs"><view class="tab {{tab==='feed'?'active':''}}" data-tab="feed" bindtap="onTab">今日同读</view><view class="tab {{tab==='rank'?'active':''}}" data-tab="rank" bindtap="onTab">本周榜单</view></view>
 <view class="section-note">{{tab==='feed'?'给今天翻开书的人，一点鼓励':'按本周阅读时长排列 · 同分并列 · 前 50 位'}}</view>
 <view class="error" wx:if="{{error}}" bindtap="load">{{error}}<view>点击重新加载 ›</view></view>
 <view wx:if="{{busy}}" class="loading">正在翻开大家的记录…</view>
 <block wx:if="{{tab==='feed'}}">
 <view class="activity" data-id="{{item.id}}" bindlongpress="onBlock" wx:for="{{entries}}" wx:key="id"><view class="activity-heading"><view class="avatar">读</view><view class="activity-person"><view class="name">{{item.name}}<text class="mine-tag" wx:if="{{item.mine}}">我</text></view><view class="tiny">今天，留了一段时间给自己</view></view></view><view class="activity-copy">已阅读 <text>{{item.minutes || '不足 1'}}</text> 分钟</view><view class="activity-actions" wx:if="{{!item.mine}}"><button data-id="{{item.id}}" bindtap="onStar" class="{{item.starred?'starred':''}}">{{item.starred?'★ 已加油':'☆ 加油'}} {{item.stars||''}}</button><button data-id="{{item.id}}" bindtap="onTomato">🍅 {{item.tomatoSent?'今天已送':'送颗番茄'}}</button></view><view class="own-stars" wx:else>☆ 收到了 {{item.stars}} 颗鼓励星星</view></view>
 </block>
 <block wx:else><view class="rank-list" wx:if="{{rank.length}}"><view class="rank-header"><text>读友</text><text>本周阅读</text></view><view class="rank-row {{item.mine?'my-rank':''}}" wx:for="{{rank}}" wx:key="id"><text class="rank-number {{item.rank<=3?'top-rank':''}}">{{item.rank}}</text><view class="rank-name">{{item.name}}<text class="mine-tag" wx:if="{{item.mine}}">我</text></view><view class="rank-time"><text>{{item.minutes || '不足 1'}}</text> 分钟</view></view></view></block>
 <view class="hall-empty" wx:if="{{!busy&&!error&&(tab==='feed'?!entries.length:!rank.length)}}"><view class="empty-drawing"><view class="draw-sun"/><view class="draw-page left-page"/><view class="draw-page right-page"/></view><view class="empty-title">{{tab==='feed'?'今天的第一页，等你翻开':'这一周，从一页开始'}}</view><view class="empty-description">{{tab==='feed'?'今天还没有同步到大厅的阅读记录。':'本周榜单还没有阅读记录。'}}<view>读一小段，让这里多一份坚持。</view></view><button class="empty-action" bindtap="onRead">去读一会儿 →</button></view>
 <view class="hall-privacy">登录后自动加入 · 仅展示昵称与阅读时长<view>你的书名、正文与感想，始终只属于你</view></view>
</view>
