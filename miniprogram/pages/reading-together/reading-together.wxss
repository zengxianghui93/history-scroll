@import "../../reading/theme.wxss";
page{background:#f5f2e9}.hall{min-height:0;padding:24rpx 32rpx 40rpx}.hall-heading{margin:8rpx 0 28rpx}.eyebrow{font-size:22rpx;letter-spacing:2rpx;color:#969181;margin-bottom:12rpx}.hall .heading{font-size:44rpx;font-weight:500;letter-spacing:2rpx;color:#33473e}.summary-card{background:linear-gradient(120deg,#526b59,#344f42);border-radius:26rpx;padding:28rpx 30rpx 0;color:#fff9e9;overflow:hidden;box-shadow:0 12rpx 28rpx #38543f18}.summary-caption{display:flex;justify-content:space-between;font-size:24rpx;letter-spacing:1rpx}.summary-caption text{font-size:20rpx;color:#c6d1bd}.summary-main{position:relative;display:flex;align-items:center;gap:48rpx;margin:22rpx 0 24rpx}.summary-number{font:64rpx/1.2 Georgia,serif}.summary-unit{font-size:22rpx;margin-left:12rpx;color:#d0d8c7}.summary-label{font-size:20rpx;color:#c6d1bd;margin-top:8rpx}.summary-days{border-left:1rpx solid #ffffff29;padding-left:30rpx;font-size:22rpx;color:#d0d8c7}.summary-days>text{font:42rpx Georgia,serif;color:#fff9e9}.summary-bottom{border-top:1rpx solid #ffffff20;padding:17rpx 0;font-size:19rpx;color:#c4d0be}.book-decoration{position:absolute;right:4rpx;bottom:6rpx;width:70rpx;height:85rpx;transform:rotate(10deg);border:1rpx solid #d8d6b75c;border-radius:3rpx;background:#f5edc510;display:flex;align-items:center;justify-content:center}.book-decoration text{font:32rpx serif;color:#ddd9b8}.book-decoration view{position:absolute;left:7rpx;top:0;bottom:0;border-left:1rpx solid #d8d6b750}.book-decoration view+view{left:11rpx}.hall .tabs{background:#e9e7dc;border:0;padding:6rpx;border-radius:18rpx;gap:0;margin:30rpx 0 18rpx}.hall .tab{flex:1;text-align:center;padding:17rpx 0;border:0;font-size:26rpx;border-radius:13rpx;color:#8a8e7d}.hall .tab.active{background:#fffdf6;color:#405a49;box-shadow:0 3rpx 9rpx #5e614811}.section-note{font-size:20rpx;color:#969381;margin:0 4rpx 20rpx}.activity{padding:26rpx;margin-bottom:18rpx;background:#fffcf5;border:1rpx solid #e8e3d6;border-radius:22rpx}.activity-heading{display:flex;gap:18rpx;align-items:center}.avatar{width:66rpx;height:66rpx;background:#e9eddf;border-radius:23rpx;display:flex;align-items:center;justify-content:center;font:30rpx serif;color:#6b805c;flex-shrink:0}.activity-person{flex:1;min-width:0}.name{font-size:27rpx;color:#45523f;line-height:1.6}.activity-person .tiny{font-size:20rpx;margin-top:3rpx}.mine-tag{font-size:18rpx;color:#829367;background:#ebeedf;padding:2rpx 9rpx;margin-left:12rpx;border-radius:5rpx}.activity-copy{font-size:23rpx;color:#8a8b79;padding:23rpx 0;border-bottom:1rpx solid #eeeade}.activity-copy text{font:38rpx Georgia,serif;color:#53694c;margin:0 9rpx}.activity-actions{display:flex;gap:14rpx;padding-top:20rpx}.activity-actions button{margin:0;padding:10rpx 20rpx;border-radius:30rpx;font-size:22rpx;line-height:1.5;background:#f2f0e5;color:#85856c}.activity-actions button.starred{background:#f5e9c7;color:#a87e41}.own-stars{font-size:21rpx;color:#a19170;padding-top:18rpx}.rank-list{border-radius:22rpx;overflow:hidden;border:1rpx solid #e8e3d6;background:#fffcf5;padding:0 24rpx}.rank-header{display:flex;justify-content:space-between;font-size:20rpx;color:#a09a88;padding:22rpx 0;border-bottom:1rpx solid #eeeade}.rank-row{display:flex;gap:20rpx;align-items:center;padding:25rpx 0;border-bottom:1rpx solid #eeeade}.rank-row:last-child{border:0}.rank-number{font:30rpx Georgia,serif;min-width:35rpx;text-align:center;color:#a4a08f}.top-rank{color:#ad8150}.rank-name{flex:1;font-size:25rpx;min-width:0;overflow:hidden}.rank-time{font-size:19rpx;color:#8f9483;flex-shrink:0}.rank-time text{font:30rpx Georgia,serif;color:#53694c}.my-rank{background:#edf0e580}.hall-empty{text-align:center;background:#fffcf5;border:1rpx solid #e8e3d6;border-radius:24rpx;padding:34rpx 24rpx}.empty-drawing{height:100rpx;width:180rpx;position:relative;margin:0 auto 22rpx}.draw-sun{position:absolute;right:20rpx;top:0;width:35rpx;height:35rpx;border-radius:50%;background:#dfb66e60}.draw-page{position:absolute;bottom:0;width:66rpx;height:65rpx;border:2rpx solid #a7af9166;background:repeating-linear-gradient(0deg,#e7e9da,#e7e9da 12rpx,#cbd1b7 13rpx,#e7e9da 14rpx);border-radius:6rpx}.left-page{left:20rpx;transform:skewY(10deg)}.right-page{right:20rpx;transform:skewY(-10deg)}.empty-title{font:30rpx/1.6 serif;color:#52634b}.empty-description{font-size:22rpx;color:#98917e;line-height:1.9;margin:12rpx 0 24rpx}.hall .empty-action{display:inline-block;width:auto;max-width:none;margin:0;background:#e9eddf;color:#52694c;border-radius:30rpx;padding:13rpx 32rpx;font-size:24rpx;line-height:1.6}.hall-privacy{text-align:center;font-size:19rpx;line-height:1.9;color:#a29d8c;margin:26rpx 0 0}
