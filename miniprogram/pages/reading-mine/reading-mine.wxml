<view class="screen mine">
 <view class="mine-header"><view><view class="eyebrow">读过的时光，都在这里</view><view class="heading">我的阅读空间</view></view><button class="settings-link" bindtap="onSettings">设置</button></view>
 <view class="overview" bindtap="onStats"><view class="overview-caption">本周阅读<text>查看记录 ›</text></view><view class="overview-stats"><view><text class="stat-number">{{stats.days}}</text><text class="stat-unit">天</text><view class="stat-label">翻开过书</view></view><view><text class="stat-number">{{stats.minutes}}</text><text class="stat-unit">分钟</text><view class="stat-label">留给自己的时间</view></view><view><text class="stat-number">{{bookCount}}</text><text class="stat-unit">本</text><view class="stat-label">书架藏书</view></view></view></view>
 <view class="section-header"><view class="section-title">我的书架</view><button class="import-button" loading="{{busy}}" disabled="{{busy}}" bindtap="onImport">＋ 导入书籍</button></view>
 <view class="tabs"><view class="tab {{filter==='reading'?'active':''}}" data-filter="reading" bindtap="onFilter">在读 <text>{{counts.reading}}</text></view><view class="tab {{filter==='complete'?'active':''}}" data-filter="complete" bindtap="onFilter">已读完 <text>{{counts.complete}}</text></view><view class="tab {{filter==='paused'?'active':''}}" data-filter="paused" bindtap="onFilter">暂时放下 <text>{{counts.paused}}</text></view></view>
 <view class="shelf">
  <view class="shelf-item" wx:for="{{library}}" wx:key="id" data-id="{{item.id}}" bindtap="onRead" bindlongpress="onManage" hover-class="pressed"><view class="cover {{index%2?'blue':''}}"><image src="/images/reading/cover.jpg" mode="aspectFill"/><view class="cover-title">{{item.title}}</view></view><view class="book-info"><view class="book-name">{{item.title}}</view><view class="book-author" wx:if="{{item.author}}">{{item.author}}</view><view class="book-progress"><text>{{item.status==='complete'?'已读完':'已读 '+item.percent+'%'}}</text><text>{{item.status==='complete'?'再翻一翻':'接着读'}} ↗</text></view><view class="progress"><view style="width:{{item.percent}}%"/></view></view><button class="manage-book" data-id="{{item.id}}" catchtap="onManage" aria-label="管理书籍">···</button></view>
 </view>
 <view class="shelf-empty" wx:if="{{!library.length}}"><view class="empty-symbol">册</view><view class="empty-title">{{filter==='reading'?'书架留了一个位置':filter==='complete'?'慢慢读，总会读完一本':'暂时没有放下的书'}}</view><view class="empty-description">{{filter==='reading'?'导入一本想读的书，从今天的一页开始。':filter==='complete'?'读完的书会收在这里，随时可以再翻开。':'读到一半也不着急，随时可以回来继续。'}}</view></view>
 <view class="section-header journal-heading"><view class="section-title">阅读纪念册</view><text class="section-count">{{journals.length}} 册</text></view><view class="section-description">按书装订阅读痕迹 · 长按封面可删除纪念册</view>
 <scroll-view class="journal-scroll" scroll-x wx:if="{{journals.length}}"><view class="journal-track"><view class="journal" wx:for="{{journals}}" wx:key="id" data-id="{{item.id}}" bindtap="onJournal" bindlongpress="onDeleteJournal" hover-class="pressed"><view class="binding"/><view class="journal-top">阅读手记 <text>{{index < 9 ? '0' : ''}}{{index+1}}</text></view><view class="journal-label">{{item.title}}</view><view class="journal-bottom"><text>翻开纪念册 ↗</text><view class="mini-seal">读</view></view></view></view></scroll-view>
 <view class="journal-empty" wx:else><text>记</text><view>还没有装订的故事<view>完成一段阅读后，会自动生成纪念册。</view></view></view>
 <view class="utility-card"><view class="utility-row" bindtap="onRestore"><view class="utility-icon">↧</view><view class="utility-copy">从云端恢复书籍<text>找回已同步的书籍，接着上次读</text></view><text class="chevron">›</text></view><view class="utility-row" bindtap="onInbox"><view class="utility-icon">☆</view><view class="utility-copy">收到的鼓励<text>星星加油和元气番茄，都在这里</text></view><text class="chevron">›</text></view><view class="utility-row" bindtap="onFeedback"><view class="utility-icon">✎</view><view class="utility-copy">意见反馈<text>让下一次阅读更舒服</text></view><text class="chevron">›</text></view></view>
 <button class="sync-button" bindtap="onSync" loading="{{busy}}">{{syncText}} ›</button>
</view>
<view class="sheet-mask" wx:if="{{settings}}" bindtap="onClose"><view class="sheet" catchtap="noop"><view class="row"><view class="sheet-title">私人阅读设置</view><button class="link" bindtap="onClose">关闭</button></view><view class="privacy">正文和感想仅本人可见。登录后自动进入同读大厅，仅展示系统昵称和阅读时长，不展示书名。</view><view class="row list-row" bindtap="onInvitations"><text>接收元气番茄</text><switch color="#40584b" checked="{{invitations}}"/></view><view class="restore-journal-section"><view class="section-title">恢复纪念册显示</view><view class="privacy">移除纪念册只隐藏入口，阅读记录和私人感想仍保留。恢复显示不会改变书籍的在读状态。</view><scroll-view scroll-y style="max-height:30vh;height:{{hidden.length > 3 ? '30vh' : hidden.length * 108 + 'rpx'}}"><view class="restore-journal-row" wx:for="{{hidden}}" wx:key="id"><text>{{item.title}}</text><button data-id="{{item.id}}" bindtap="onRestoreJournal">恢复显示</button></view></scroll-view><view class="tiny" wx:if="{{!hidden.length}}">没有需要恢复的纪念册</view></view><button class="secondary" bindtap="onSync" loading="{{busy}}">同步书籍与阅读记录</button><view class="privacy">第一版支持 30 本书、单本 10MB、正文 100 万字以内。书籍在本机缓存，云端按用户隔离保存。单设备使用。</view></view></view>
