ent:space-between;color:#d6ddc7;font-size:18rpx;letter-spacing:2rpx}.journal-label{margin:20rpx 0;padding:14rpx;background:#f3edda;border:3rpx double #b6ad8a;font:25rpx/1.6 serif;color:#536048;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;word-break:break-all}.journal-bottom{margin-top:auto;display:flex;align-items:center;justify-content:space-between;font-size:19rpx;color:#d9decb}.mini-seal{font:22rpx serif;border:3rpx double #e4c4a5;background:#f1ddc5;color:#a66650;padding:4rpx;transform:rotate(-5deg)}.journal-empty{display:flex;align-items:center;gap:20rpx;padding:26rpx;border:1rpx solid #e2decd;border-radius:18rpx;color:#737c62;font-size:25rpx}.journal-empty>text{font:36rpx serif;color:#a2a88c}.journal-empty>view>view{font-size:21rpx;color:#9a9584;margin-top:8rpx}.utility-card{background:#fffcf5;border:1rpx solid #e8e3d6;border-radius:22rpx;padding:0 24rpx;margin-top:32rpx}.utility-row{display:flex;align-items:center;gap:20rpx;padding:23rpx 0;border-bottom:1rpx solid #eeeadf}.utility-row:last-child{border:0}.utility-icon{width:54rpx;height:54rpx;display:flex;align-items:center;justify-content:center;font-size:31rpx;color:#8c9678;background:#eeefe2;border-radius:16rpx}.utility-copy{flex:1;font-size:25rpx;color:#58624d}.utility-copy text{display:block;font-size:20rpx;color:#a09a89;margin-top:7rpx}.chevron{color:#b0a994;font-size:30rpx}.mine .sync-button{width:100%;max-width:none;background:transparent;font-size:19rpx;line-height:1.7;color:#a09b8b;padding:22rpx 0 0;margin:0}

.restore-journal-section{margin:24rpx 0;padding:22rpx 0;border-top:1rpx solid var(--line)}.restore-journal-row{display:flex;align-items:center;gap:16rpx;padding:16rpx 0;border-bottom:1rpx solid var(--line)}.restore-journal-row>text{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:25rpx}.restore-journal-row button{flex-shrink:0;margin:0;padding:10rpx 16rpx;border-radius:12rpx;background:#e8eddf;color:#5b7350;font-size:22rpx;line-height:1.5}
