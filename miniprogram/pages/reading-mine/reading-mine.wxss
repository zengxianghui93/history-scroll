@import "../../reading/theme.wxss";
page{background:#f5f2e9}.mine{min-height:0;padding:24rpx 32rpx 32rpx}.mine-header{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:8rpx 0 30rpx}.eyebrow{font-size:22rpx;letter-spacing:2rpx;color:#969181;margin-bottom:12rpx}.mine .heading{font-size:42rpx;font-weight:500;letter-spacing:1rpx;color:#33473e}.settings-link{margin:20rpx 0 0;padding:10rpx 18rpx;border:1rpx solid #dedfce;border-radius:30rpx;background:transparent;font-size:23rpx;line-height:1.5;color:#6f7b64;flex-shrink:0}.overview{background:linear-gradient(120deg,#e7ebdc,#f0eee1);border:1rpx solid #dfe3d2;border-radius:24rpx;padding:26rpx}.overview-caption{display:flex;justify-content:space-between;color:#52674b;font-size:24rpx}.overview-caption text{font-size:20rpx;color:#929781}.overview-stats{display:flex;margin-top:24rpx}.overview-stats>view{flex:1;text-align:center;border-left:1rpx solid #d5dbc8}.overview-stats>view:first-child{border:0}.stat-number{font:44rpx/1.3 Georgia,serif;color:#4f6849}.stat-unit{font-size:20rpx;color:#849071;margin-left:7rpx}.stat-label{font-size:20rpx;color:#929580;margin-top:7rpx}.section-header{display:flex;justify-content:space-between;align-items:center;margin-top:34rpx;gap:16rpx}.mine .section-title{font-size:31rpx;font-weight:500;color:#3e503e}.import-button{margin:0;padding:12rpx 22rpx;line-height:1.6;background:#45624d;color:#fff9eb;border-radius:30rpx;font-size:23rpx;flex-shrink:0}.mine .tabs{background:#eae8dd;border:0;border-radius:16rpx;padding:5rpx;margin:20rpx 0;gap:0}.mine .tab{flex:1;text-align:center;border:0;padding:14rpx 0;font-size:24rpx;border-radius:12rpx}.mine .tab text{font-size:20rpx;margin-left:6rpx;opacity:.65}.mine .tab.active{background:#fffcf5;color:#4c6547;box-shadow:0 3rpx 8rpx #40584b0d}.shelf-item{display:flex;position:relative;gap:24rpx;padding:24rpx;margin-bottom:16rpx;background:#fffcf5;border:1rpx solid #e8e3d6;border-radius:20rpx;align-items:center}.shelf-item .cover{width:124rpx;height:174rpx;flex-shrink:0;b