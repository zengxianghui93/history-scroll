page { background: #F5EDDF; color: #493B2B; }
.preview-page { padding: 30rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }
.preview-cover { height: 540rpx; position: relative; overflow: hidden; border-radius: 110rpx 24rpx 24rpx 24rpx; }
.preview-cover image { width: 100%; height: 100%; }
.preview-wash { position: absolute; inset: 0; background: linear-gradient(0deg,rgba(42,35,27,.87),transparent 75%); }
.preview-cover-copy { position: absolute; left: 36rpx; bottom: 34rpx; color: #FFF0D4; }
.preview-cover-copy text { font-size: 24rpx; letter-spacing: 3rpx; }
.preview-cover-copy view { margin: 14rpx 0; font: 76rpx/1.3 serif; }
.preview-paper { padding: 36rpx 28rpx 20rpx; }
.preview-kicker { color: #A17B4D; font-size: 23rpx; letter-spacing: 3rpx; }
.preview-title { font: 37rpx/1.6 serif; margin: 18rpx 0; }
.preview-copy { color: #756550; font-size: 28rpx; line-height: 1.9; }
.preview-primary { background: #78503A; color: #FFF1D6; border-radius: 15rpx; font-size: 28rpx; margin: 30rpx 0 24rpx; }
.preview-note { color: #92806A; font-size: 24rpx; line-height: 1.8; }
.preview-back { margin-top: 24rpx; color: #64724F; background: transparent; font-size: 27rpx; }
button::after { border: none; }
