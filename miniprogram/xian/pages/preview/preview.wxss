@import "../../../styles/xian-theme.wxss";
page { background: #EEE3D1; color: #303837; }
.preview-page { min-height: 100vh; box-sizing: border-box; padding: 30rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); background: var(--xian-paper); color: var(--xian-ink); }
.preview-cover { height: 540rpx; position: relative; overflow: hidden; border: 1rpx solid var(--xian-border); border-radius: 110rpx 24rpx 24rpx 24rpx; box-shadow: 0 10rpx 25rpx #49352130; }
.preview-cover image { width: 100%; height: 100%; }
.preview-wash { position: absolute; inset: 0; background: linear-gradient(0deg,rgba(31,39,38,.9),transparent 76%); }
.preview-cover-copy { position: absolute; left: 36rpx; bottom: 34rpx; color: #FFF0D4; }
.preview-cover-copy text { font-size: 24rpx; letter-spacing: 3rpx; }
.preview-cover-copy view { margin: 14rpx 0; font: 76rpx/1.3 serif; }
.preview-paper { margin-top: 20rpx; padding: 36rpx 28rpx 24rpx; border: 1rpx solid var(--xian-border); border-radius: 18rpx; background: var(--xian-sheet); box-shadow: 0 5rpx 15rpx #60422A12; }
.preview-kicker { color: var(--xian-cinnabar); font-size: 23rpx; letter-spacing: 3rpx; }
.preview-title { font: 37rpx/1.6 serif; margin: 18rpx 0; }
.preview-copy { color: var(--xian-muted); font-size: 28rpx; line-height: 1.9; }
.preview-primary { background: var(--xian-cinnabar); color: #FFF4E0; border-radius: 15rpx; font-size: 28rpx; margin: 30rpx 0 24rpx; box-shadow: 0 5rpx 12rpx #6E3A2B2B; }
.preview-divider { height: 1rpx; margin: 12rpx 0 30rpx; background: var(--xian-border); }
.preview-secondary { background: var(--xian-night); }
.preview-note { color: var(--xian-muted); font-size: 24rpx; line-height: 1.8; }
.preview-back { margin-top: 24rpx; color: var(--xian-cinnabar); background: transparent; font-size: 27rpx; }
button::after { border: none; }
