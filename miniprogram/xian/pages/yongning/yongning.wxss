@import "../../../styles/xian-theme.wxss";
page { background: #EEE3D1; color: #303837; }
.page { min-height: 100vh; box-sizing: border-box; padding: 32rpx 28rpx 42rpx; background: var(--xian-paper); color: var(--xian-ink); }
.eyebrow { display: flex; justify-content: space-between; color: var(--xian-cinnabar); font-size: 24rpx; }
.title, .heading { font-family: "Songti SC", "SimSun", serif; font-weight: 700; }
.title { margin: 12rpx 0; font-size: 68rpx; line-height: 1.12; }
.intro, .body { font-size: 29rpx; line-height: 1.82; }
.intro { color: var(--xian-muted); }
.cover { position: relative; height: 324rpx; margin: 24rpx 0 30rpx; overflow: hidden; border-radius: 18rpx; border: 1rpx solid var(--xian-border); background: var(--xian-night); box-shadow: 0 7rpx 18rpx #46332624; }
.cover image { position: absolute; left: 0; top: -528rpx; width: 100%; height: 1038rpx; }
.chapter { margin-bottom: 18rpx; padding: 25rpx; border: 1rpx solid var(--xian-border); border-radius: 18rpx; background: var(--xian-sheet); }
.kicker { margin-bottom: 9rpx; color: var(--xian-cinnabar); font-size: 23rpx; letter-spacing: 2rpx; }
.heading { font-size: 37rpx; line-height: 1.38; }
.body { margin-top: 15rpx; }
.gate-plan { margin-top: 23rpx; padding: 18rpx; border-radius: 10rpx; color: #F7EBD8; background: var(--xian-night); }
.plan-caption { margin-bottom: 18rpx; color: #E6C99E; font-size: 21rpx; letter-spacing: 2rpx; }
.plan-line { display: flex; align-items: center; justify-content: space-between; }
.plan-step { flex: 1; display: flex; flex-direction: column; align-items: center; font-size: 26rpx; font-weight: 600; }
.plan-space { color: #E6C99E; font-size: 23rpx; font-weight: 400; }
.court-symbol { width: 70%; height: 50rpx; box-sizing: border-box; margin-bottom: 8rpx; border-block: 2rpx solid #A78C71; color: #F0BA79; text-align: center; line-height: 46rpx; }
.gate-symbol { width: 65%; height: 50rpx; margin-bottom: 8rpx; background: #E9BA89; clip-path: polygon(0 38%, 50% 4%, 100% 38%, 87% 40%, 87% 100%, 62% 100%, 62% 63%, 38% 63%, 38% 100%, 13% 100%, 13% 40%); }
.gate-symbol.arrow-tower { width: 78%; background: #D88F74; }
.gate-symbol.inner { width: 82%; background: #F4CE93; }
.plan-side { display: flex; justify-content: space-between; margin-top: 12rpx; padding-top: 8rpx; border-top: 1rpx dashed #A78C71; color: #E6C99E; font-size: 20rpx; }
.field-note { background: #E8D8BC; }
.actions { display: flex; gap: 12rpx; margin-top: 25rpx; }
.actions button { flex: 1; width: auto; min-width: 0; max-width: none; margin: 0; padding: 14rpx 8rpx; border: 1rpx solid var(--xian-border); border-radius: 10rpx; background: var(--xian-sheet); color: var(--xian-cinnabar); font-size: 25rpx; line-height: 1.55; }
.actions button::after { border: 0; }
.actions button.pressed { background: #EAD4B5; }
