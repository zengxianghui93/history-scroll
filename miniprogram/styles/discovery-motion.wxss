/* 只在按下时反馈，不持续闪烁，也不延迟业务操作。 */
.page .motion-control { transition: opacity 120ms ease, transform 120ms ease; }
.page .motion-control.motion-pressed { opacity: .78; transform: scale(.985); }
@media (prefers-reduced-motion: reduce) {
  .page .motion-control { transition: none; }
  .page .motion-control.motion-pressed { transform: none; }
}
