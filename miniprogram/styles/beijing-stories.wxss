/* 容器负责整行排版，按钮只承载点击，避免原生按钮默认宽度挤窄故事卡。 */
.topic-list { width: 100%; }
.topic-shell { width: 100%; margin-bottom: 18rpx; }
.page .topic-list .topic-shell button.topic-card { display: block; width: 100%; min-width: 0; max-width: none; box-sizing: border-box; margin: 0; padding: 22rpx; border: 1rpx solid #DDCDB1; border-radius: 16rpx 16rpx 30rpx 16rpx; background: #FFFBF2; box-shadow: 0 4rpx 14rpx #78633F08; text-align: left; font-weight: 400; line-height: 1.6; }
.topic-content { display: flex; align-items: stretch; width: 100%; }
.topic-cover { flex: 0 0 138rpx; width: 138rpx; height: 178rpx; position: relative; overflow: hidden; border-radius: 10rpx 10rpx 22rpx 10rpx; background: #E9DEC5; margin-right: 24rpx; }
.topic-cover-image { display: block; width: 100%; height: 100%; }
.topic-cover .topic-illustration { position: absolute; max-width: none; }
.topic-cover .topic-illustration.royal { width: 520rpx; height: 780rpx; left: -269rpx; top: -340rpx; }
.topic-cover .topic-illustration.history { width: 440rpx; height: 660rpx; left: -204rpx; top: -438rpx; }
.topic-cover .topic-illustration.hutong { width: 520rpx; height: 780rpx; left: -98rpx; top: -248rpx; }
.topic-body { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.topic-title { font-size: 30rpx; font-weight: 600; color: #4E493B; line-height: 1.55; overflow-wrap: break-word; }
.topic-subtitle { font-size: 22rpx; font-weight: 400; color: #94836A; line-height: 1.7; margin-top: 8rpx; }
.topic-footer { display: flex; align-items: center; justify-content: space-between; padding-top: 16rpx; margin-top: auto; }
.topic-duration { font-size: 22rpx; color: #687C5B; }
.topic-action { margin-left: auto; color: #657A52; font-size: 22rpx; white-space: nowrap; }
.page .topic-list .topic-shell.history button.topic-card { background: #F8F6EA; border-color: #D9D4BE; }
.page .topic-list .topic-shell.hutong button.topic-card { background: #F2F4E9; border-color: #D3DAC4; }
.page .topic-list .topic-shell.water-cube button.topic-card { background: #F1F5EF; border-color: #D1DDD1; }
