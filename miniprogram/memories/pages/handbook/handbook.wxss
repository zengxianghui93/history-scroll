@import "../../../components/landmark-seal/landmark-ink.wxss";
@import "../../../styles/xian-theme.wxss";
page{height:100%;background:#eae2d2;color:#494335}.handbook{height:100%;box-sizing:border-box;padding:22rpx 28rpx calc(12rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;--ink:#536449;--accent:#a94b38;--paper:#faf2de;background:radial-gradient(ellipse at 95% 4%,#f6efdf,transparent 65%),#eae2d2}.handbook-xian{--ink:#735542;--accent:#a44732;--paper:#f3e5cd;background:#e6d7c2}.book-top{display:flex;justify-content:space-between;align-items:center;padding:0 8rpx 20rpx;flex-shrink:0}.eyebrow{font-size:19rpx;letter-spacing:3rpx;color:#8b7b63}.book-title{font:38rpx/1.5 serif;margin-top:8rpx}.book-count{font-size:23rpx;color:var(--ink);border-bottom:1rpx solid #bcad91;padding-bottom:5rpx}.book-swiper{flex:1;min-height:0;width:100%;filter:drop-shadow(5rpx 10rpx 10rpx #5e492125)}.book-paper{height:calc(100% - 16rpx);margin:3rpx 8rpx 13rpx 3rpx;box-sizing:border-box;position:relative;overflow:hidden;border:1rpx solid #cdbb98;border-radius:5rpx 16rpx 16rpx 5rpx;background:repeating-linear-gradient(3deg,#fff4 0,#fff4 1rpx,transparent 1rpx,transparent 7rpx),radial-gradient(ellipse at 100% 50%,#fff8ee,transparent 80%),var(--paper);box-shadow:4rpx 3rpx 0 -1rpx #e8d9bd,7rpx 6rpx 0 -2rpx #baa98b,inset 15rpx 0 23rpx #80683a14,inset -8rpx 0 12rpx #ad96651c}.binding{position:absolute;top:0;bottom:0;left:10rpx;width:17rpx;z-index:2;border-right:1rpx solid #9a805739;background:linear-gradient(90deg,#a28b5d33,transparent);pointer-events:none}.binding::after{content:"";position:absolute;left:4rpx;top:10%;height:80%;border-left:3rpx dashed #a18e6a55}.cover-art{position:absolute;width:100%;height:100%;opacity:.83}.cover-wash{position:absolute;inset:0;background:linear-gradient(180deg,#f7f0ddf0 0%,#f7f0dd7a 26%,transparent 53%,#f4ead7 100%)}.cover-frame{position:absolute;inset:25rpx;border:1rpx solid #9b81585c;box-shadow:inset 0 0 0 5rpx #f3e9d350}.cover-brand{position:absolute;top:55rpx;left:52rpx;font-size:19rpx;letter-spacing:4rpx;color:#7f7159}.cover-name{position:absolute;left:54rpx;top:105rpx;font:100rpx/1.2 serif;color:#393c30;letter-spacing:14rpx}.cover-subtitle{position:absolute;left:62rpx;top:240rpx;font:30rpx serif;letter-spacing:13rpx}.cover-seal{position:absolute;right:54rpx;top:122rpx;writing-mode:vertical-rl;border:5rpx double var(--accent);padding:14rpx 8rpx;color:var(--accent);font:35rpx serif;transform:rotate(-6deg)}.cover-bottom{position:absolute;bottom:64rpx;left:53rpx;right:35rpx;font:27rpx/1.9 serif}.cover-bottom text{font:20rpx sans-serif;color:#7d715b;display:block;margin-top:15rpx;letter-spacing:2rpx}.leaf-paper{padding:28rpx 29rpx 26rpx 44rpx;display:flex;flex-direction:column}.leaf-kicker{font-size:19rpx;letter-spacing:3rpx;color:#8c7b5f;margin-bottom:18rpx}.leaf-art-frame{flex:1;min-height:0;overflow:hidden;border-radius:55% 55% 3rpx 3rpx / 12% 12% 3rpx 3rpx;border:1rpx solid #cbb792;padding:6rpx;background:#efe3cd}.leaf-art-frame image{width:100%;height:100%;display:block}.leaf-story{padding:20rpx 3rpx 10rpx}.leaf-name{font:35rpx/1.45 serif;color:#494132;letter-spacing:2rpx}.leaf-excerpt{font:26rpx/1.85 serif;color:#756850;margin-top:12rpx}.leaf-bottom{display:flex;justify-content:space-between;align-items:center;gap:12rpx;padding-top:8rpx}.leaf-note{font-size:20rpx;color:#7e735e}.leaf-signature{font:20rpx/2 serif;color:#a08a66;letter-spacing:1rpx}.leaf-stamp{width:116rpx;height:116rpx;flex-shrink:0;transform:rotate(-7deg);box-shadow:0 4rpx 8rpx #70251a19}.leaf-stamp image{height:100%;width:100%}.text-ink{height:100%;box-sizing:border-box;border:6rpx double #f4c99b;outline:1rpx solid #a24734;background:#9f4030;color:#ffe4b6;display:flex;align-items:center;justify-content:center;padding:8rpx;font:26rpx/1.3 serif;text-align:center}.leaf-folio{text-align:center;font-size:18rpx;color:#a99877;margin-top:6rpx}.closing-paper{padding:65rpx 55rpx;display:flex;flex-direction:column;justify-content:center}.closing-mark{font:54rpx serif;border:5rpx double var(--accent);padding:17rpx;color:var(--accent);align-self:flex-start;transform:rotate(-5deg);margin-bottom:40rpx}.closing-title{font:37rpx/1.7 serif}.closing-copy{font:26rpx/2 serif;color:#8c795d;margin-top:22rpx}.closing-rule{height:1rpx;background:#d6c6aa;margin:28rpx 0 0}.explore-button{background:var(--ink);color:#fff4db;width:100%;border-radius:8rpx;font-size:26rpx;margin-top:35rpx}.page-navigation{display:flex;align-items:center;gap:18rpx;font-size:19rpx;color:#8a795d;padding:12rpx 8rpx 18rpx;flex-shrink:0}.page-track{height:3rpx;flex:1;background:#cfc0a5;overflow:hidden}.page-track view{height:100%;background:var(--ink);transition:width .4s}.handbook-actions{display:flex;gap:12rpx;flex-shrink:0}.export-primary{background:var(--ink);color:#fff4db;flex:1;font-size:26rpx;border-radius:10rpx;padding:0 12rpx}.share-button{font-size:25rpx;background:#f9f1df;color:#726044;border-radius:10rpx;padding:0 24rpx}.export-options{display:flex;justify-content:center;gap:20rpx;flex-shrink:0;margin-top:4rpx}.export-options button{font-size:21rpx;background:transparent;color:#8a7453;margin:0;padding:4rpx 0}.export-options button::after{border:0}.export-hint{font-size:17rpx;color:#9f8e73;text-align:center;flex-shrink:0}.export-error{font-size:21rpx;color:#a14532;text-align:center;flex-shrink:0;margin-top:8rpx}.export-canvas{position:fixed;left:-2000px;top:0;width:750px;height:1050px;pointer-events:none}button[disabled]{opacity:.5}
@media (prefers-reduced-motion:reduce){.page-track view{transition:none}}

.leaf-art-frame.full-art{border-radius:5rpx;background:#f7efdf}.palace-ink{position:relative;width:100%;height:100%;overflow:hidden}.palace-ink image{position:absolute;width:253%;height:380%;left:-73%;top:-210%}.export-error button{background:transparent;color:#8a7453;font-size:21rpx;padding:0;line-height:1.8}.export-error button::after{border:0}

.handbook-xian { --ink: var(--xian-ink); --accent: var(--xian-cinnabar); --paper: var(--xian-sheet); background: var(--xian-paper); color: var(--xian-ink); }
.handbook-xian .eyebrow, .handbook-xian .book-count { color: var(--xian-cinnabar); }
.handbook-xian .book-paper { border-color: var(--xian-border); }
.handbook-xian .cover-wash { background: linear-gradient(180deg, #FAF0DEF0 0%, #FAF0DE78 28%, transparent 55%, #EEE3D1 100%); }
.handbook-xian .cover-name, .handbook-xian .leaf-name { color: var(--xian-ink); }
.handbook-xian .leaf-art-frame { border-color: var(--xian-border); background: #E7D7BB; }
.handbook-xian .leaf-kicker, .handbook-xian .leaf-note, .handbook-xian .leaf-excerpt, .handbook-xian .closing-copy { color: var(--xian-muted); }
.handbook-xian .share-button { background: var(--xian-sheet); color: var(--xian-cinnabar); }
