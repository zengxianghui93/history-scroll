<import src="../../../components/landmark-seal/landmark-ink.wxml" />
<view wx:if="{{book}}" class="handbook {{book.cityId === 'city_xian' ? 'handbook-xian xian-theme' : ''}}">
  <view class="book-top"><view><text class="eyebrow">{{shared ? '朋友分享的探索纪念' : '把一城发现，装订成册'}}</text><view class="book-title">{{book.cityName}}{{book.preview ? '试读纪念册' : '探索手册'}}</view></view><text class="book-count">{{book.leaves.length}} 枚印章</text></view>
  <swiper class="book-swiper" current="{{pageIndex}}" bindchange="onPageChange" duration="450" easing-function="easeInOutCubic" aria-label="左右滑动翻阅探索手册">
    <swiper-item><view class="book-paper cover-paper"><image class="cover-art" src="{{book.cover}}" mode="aspectFill"/><view class="cover-wash"/><view class="cover-frame"/><view class="binding"/><view class="cover-brand">大 千 小 卷 · 探 索 纪 念</view><view class="cover-name">{{book.cityName}}</view><view class="cover-subtitle">探索手册</view><view class="cover-seal">{{book.cityId === 'city_beijing' ? '京' : '長安'}}</view><view class="cover-bottom"><view>{{book.sentence}}</view><text>{{book.complete ? '本城已集齐 · 一册圆满' : book.leaves.length ? '已收录 ' + book.leaves.length + ' 段发现' : '你的第一段发现，正等着落在纸上'}}</text></view></view></swiper-item>
    <swiper-item wx:for="{{book.leaves}}" wx:key="id"><view class="book-paper leaf-paper"><view class="binding"/><view class="leaf-kicker">{{book.cityName}} · 第 {{index + 1}} 段发现</view><view class="leaf-art-frame {{item.fullArt ? 'full-art' : ''}}"><image wx:if="{{pageIndex >= index && pageIndex <= index + 2}}" src="{{item.image}}" mode="{{item.fullArt ? 'aspectFit' : 'aspectFill'}}"/></view><view class="leaf-story"><view class="leaf-name">{{item.name}}</view><view class="leaf-excerpt">{{item.excerpt}}</view></view><view class="leaf-bottom"><view><view class="leaf-note">这一处，已在画卷中点亮</view><text class="leaf-signature">一城慢慢看 · 一页慢慢记</text></view><view class="leaf-stamp"><view wx:if="{{item.inkArt}}" class="palace-ink"><image src="{{item.inkArt}}" mode="scaleToFill"/></view><template wx:elif="{{item.customInk}}" is="landmark-ink" data="{{landmarkId:item.id,compact:true}}"/><view wx:else class="text-ink">{{item.name}}</view></view></view><view class="leaf-folio">— {{index + 1}} —</view></view></swiper-item>
    <swiper-item><view class="book-paper closing-paper"><view class="binding"/><view class="closing-mark">{{book.complete ? '成册' : '待续'}}</view><view class="closing-title">{{book.leaves.length ? '收好这一城的发现' : '故事，从第一枚章开始'}}</view><view class="closing-copy">{{book.preview ? '这一卷还在绘制，你已经留下的发现会好好保存。完整城市准备好后，再续写下一页。' : book.complete ? '这一册已经圆满。那些让你停下来的细节，随时值得再翻一遍。' : '不必一次走完。下次点亮一处地标，这本手册就会多一页。'}}</view><view class="closing-rule"/><view class="closing-copy">{{shared ? '这是朋友主动分享的印章快照。你的探索，从自己的画卷开始。' : '这里记录的是画卷中的探索，留住每一次“原来如此”。'}}</view><button class="explore-button" bindtap="onExplore">{{book.preview ? '看看西安预告 ›' : '展开' + book.cityName + '画卷 ↗'}}</button></view></swiper-item>
  </swiper>
  <view class="page-navigation"><text>左右滑动翻页</text><view class="page-track"><view style="width:{{(pageIndex + 1) * 100 / (book.leaves.length + 2)}}%"/></view><text>{{pageIndex + 1}} / {{book.leaves.length + 2}}</text></view>
  <view class="handbook-actions"><button class="export-primary" bindtap="onSaveCover" disabled="{{busy || !book.leaves.length}}" loading="{{busy}}">导出{{shared ? '这本' : '我的'}}探索手册</button><button class="share-button" open-type="share">分享手册 ↗</button></view>
  <view class="export-options"><button wx:if="{{pageIndex > 0 && pageIndex <= book.leaves.length}}" disabled="{{busy}}" bindtap="onSaveLeaf">保存当前页</button><button wx:if="{{book.leaves.length}}" disabled="{{busy}}" bindtap="onSaveLong">导出全部内页长图</button><button wx:if="{{pageIndex > 0 && pageIndex <= book.leaves.length}}" bindtap="onOpenStory">重读这段故事 ›</button></view>
  <view class="export-hint">封面收录最多三枚印章 · 长图每四页保存一张</view><view wx:if="{{error}}" class="export-error">{{error}}<button bindtap="onOpenSettings">检查相册权限 ›</button></view>
  <canvas id="handbook-canvas" type="2d" class="export-canvas"/>
</view>
