page{background:#f8f5ed;color:#303831;font-family:-apple-system,"PingFang SC",sans-serif;--paper:#f8f5ed;--green:#40584b;--red:#a85c46;--muted:#8c887c;--line:#e3ded3}button::after{border:0}button{font-weight:400}.screen{padding:28rpx 36rpx 48rpx;min-height:100vh;box-sizing:border-box}.heading{font:600 50rpx/1.4 "Songti SC",serif}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.muted{color:var(--muted);font-size:25rpx;line-height:1.8}.link{background:transparent;color:var(--red);font-size:25rpx;padding:10rpx 0;margin:0;line-height:1.5}.primary{background:var(--green);color:#fffdf6;font-size:30rpx;padding:21rpx 20rpx;line-height:1.5;border-radius:18rpx;width:100%;box-shadow:0 5rpx 12rpx #40584b16}.secondary{background:#efe9dc;color:#5b6254;padding:16rpx;font-size:26rpx;border-radius:14rpx;line-height:1.6}.pressed{opacity:.75;transform:scale(.985)}.cover{position:relative;width:270rpx;height:370rpx;border-radius:5rpx 11rpx 11rpx 5rpx;background:#eee5cf;box-shadow:inset 9rpx 0 12rpx #6b57372b,9rpx 13rpx 20rpx #695a3925,3rpx 2rpx 0 #ddd3bb;overflow:hidden}.cover image{position:absolute;width:100%;height:100%}.cover::after{content:"";position:absolute;left:10rpx;top:0;bottom:0;border-left:2rpx solid #b5a47a4d;box-shadow:3rpx 0 5rpx #fff8}.cover-title{position:relative;text-align:center;padding:36rpx 22rpx 0;font:600 36rpx/1.5 "Songti SC",serif;word-break:break-all;color:#303d34}.cover-author{position:relative;text-align:center;padding:14rpx 20rpx;font-size:21rpx;color:#626451}.cover.blue{background:#ced9d7}.cover.blue image{filter:hue-rotate(45deg);opacity:.7}.tabs{display:flex;gap:42rpx;border-bottom:1rpx solid var(--line);margin:24rpx 0}.tab{padding:18rpx 0;color:var(--muted);font-size:28rpx;border-bottom:4rpx solid transparent}.tab.active{color:#354b3e;border-color:var(--red)}.empty{text-align:center;padding:65rpx 24rpx;line-height:1.9;color:#888575;font-size:27rpx}.empty-mark{font:70rpx/1.5 serif;color:#b9ad91;margin-bottom:20rpx}.error{margin:18rpx 0;padding:18rpx;border:1rpx solid #d8b6a6;border-radius:12rpx;font-size:24rpx;color:#9a5744;line-height:1.7}.progress{height:6rpx;border-radius:8rpx;background:#e6dfd2;overflow:hidden;margin:14rpx 0}.progress view{height:100%;background:var(--red)}.sheet-mask{position:fixed;inset:0;background:#26362c66;z-index:20;display:flex;align-items:flex-end}.sheet{background:var(--paper);border-radius:30rpx 30rpx 0 0;padding:32rpx 36rpx calc(34rpx + env(safe-area-inset-bottom));width:100%;box-sizing:border-box;max-height:85vh;overflow:auto}.sheet-title{font:600 36rpx/1.6 serif;margin-bottom:16rpx}.section-title{font:600 35rpx/1.5 serif}.list-row{padding:24rpx 0;border-bottom:1rpx solid var(--line);font-size:28rpx}.notice{margin-top:22rpx;padding:22rpx 24rpx;background:#eee9de;border:1rpx solid #e3dccc;border-radius:18rpx;font-size:25rpx;line-height:1.7}.tiny{font-size:22rpx;color:var(--muted)}.seal{display:inline-flex;padding:10rpx 14rpx;border:5rpx double var(--red);font:28rpx serif;color:var(--red);transform:rotate(-6deg)}.loading{padding:35rpx;text-align:center;color:#8c887c;font-size:25rpx}.actions{display:flex;gap:16rpx;margin-top:22rpx}.actions button{flex:1}.privacy{font-size:23rpx;color:#8c887c;line-height:1.8;margin:18rpx 0}

