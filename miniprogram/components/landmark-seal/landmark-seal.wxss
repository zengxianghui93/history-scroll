@import "./landmark-ink.wxss";
.seal-footer { margin-top: 28rpx; }
button::after { border: 0; }
.seal-footer button.seal-action {
  display: flex; align-items: center; justify-content: center; gap: 18rpx; box-sizing: border-box;
  width: 100%; min-width: 0; max-width: none; min-height: 100rpx; margin: 0; padding: 12rpx 18rpx;
  border: 2rpx solid #743327; border-radius: 24rpx;
  background: linear-gradient(155deg, #AB4B3A, #783024); color: #FFF4DF;
  box-shadow: inset 0 2rpx 2rpx #F0B58980, inset 0 -5rpx 0 #511D174D, 0 6rpx 10rpx #763A302B;
  font-size: 30rpx; font-weight: 600; line-height: 1.4;
}
.ink-well {
  flex: 0 0 66rpx; height: 56rpx; border: 3rpx double #E7BA83; border-radius: 50%;
  background: radial-gradient(ellipse at 42% 25%, #CD6C52, #852D23 77%);
  box-shadow: inset 0 3rpx 7rpx #531B19AA; color: #FFE0B7;
  font: 700 30rpx/54rpx "Songti SC", "SimSun", serif; text-align: center;
}
.seal-footer button.seal-action.seal-pressed { transform: translateY(2rpx); box-shadow: inset 0 2rpx 6rpx #511D1790, 0 2rpx 4rpx #763A302B; }
.seal-keepsake {
  display: flex; align-items: center; justify-content: center; gap: 23rpx; padding: 14rpx 18rpx;
  border: 1rpx solid #DFC8A3; border-radius: 18rpx; background: #F8EDD6; color: #6D3D2F;
}
.seal-earned-art, .seal-earned-mark {
  position: relative; flex: 0 0 88rpx; height: 88rpx; overflow: hidden; box-sizing: border-box;
  border-radius: 8rpx; transform: rotate(-5deg); box-shadow: 1rpx 4rpx 7rpx #74332736;
}
.seal-earned-art image { position: absolute; width: 265%; height: 398%; left: -78%; top: -222%; }
.seal-earned-mark {
  border: 6rpx double #AA4635; background: #F5DBB0; color: #9B392B; text-align: center;
  font: 700 47rpx/76rpx "Songti SC", "SimSun", serif;
}
.seal-earned-title { font-size: 29rpx; font-weight: 700; }
.seal-earned-note { margin-top: 4rpx; color: #7D654C; font-size: 22rpx; line-height: 1.5; }
.seal-overlay { position: fixed; inset: 0; z-index: 20; display: flex; align-items: center; justify-content: center; padding: 32rpx; background: rgba(52, 41, 29, .52); }
.seal-paper { width: 100%; max-width: 554rpx; box-sizing: border-box; padding: 45rpx 32rpx 20rpx; border: 1rpx solid #DEC7A4; border-radius: 20rpx; text-align: center; background: #FBF0D9; box-shadow: 0 18rpx 55rpx rgba(52, 41, 29, .3); }
.seal-imprint { display: flex; align-items: center; justify-content: center; width: 172rpx; height: 172rpx; box-sizing: border-box; margin: 0 auto 25rpx; padding: 14rpx; border: 7rpx double #A14A36; border-radius: 13rpx; color: #A14A36; transform: rotate(-7deg); font-family: "Songti SC", "SimSun", serif; font-size: 36rpx; font-weight: 700; line-height: 1.1; animation: seal-strike 440ms ease-out both; }
.seal-imprint.short-name { font-size: 48rpx; }
.seal-imprint.custom-imprint { padding: 0; border: 0; }
.seal-result { animation: seal-result 220ms 780ms ease-out both; }
.seal-result-title { color: #47392B; font-size: 32rpx; font-weight: 700; }
.seal-result-note { margin: 10rpx 0 23rpx; color: #756149; font-size: 24rpx; }
.seal-paper button { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-width: 0; max-width: none; min-height: 78rpx; margin: 0; padding: 13rpx 8rpx; font-size: 25rpx; line-height: 1.55; }
.seal-paper .seal-return { border-radius: 10rpx; background: #526A42; color: #FFF9EC; }
.seal-paper .seal-close { margin-top: 5rpx; background: transparent; color: #675641; }
.seal-overlay.palace-overlay { background: radial-gradient(ellipse at 50% 36%, rgba(68, 59, 32, .91), rgba(24, 28, 19, .96) 72%); }
.seal-paper.palace-paper { padding: 0; border: 0; background: transparent; box-shadow: none; }
.palace-stage { position: relative; width: min(480rpx, 42vh); height: min(720rpx, 63vh); margin: 0 auto; overflow: hidden; border-radius: 16rpx; box-shadow: 0 18rpx 54rpx rgba(14, 15, 9, .5); animation: palace-card-rise 300ms ease-out both; }
.palace-layer { position: absolute; inset: 0; width: 100%; height: 100%; }
.palace-reveal { animation: palace-reveal 190ms 630ms ease-out both; }
.palace-stamp {
  clip-path: polygon(54% 50.5%, 60% 40.2%, 65% 38.9%, 68% 35.7%, 70.5% 35.6%, 72% 32.2%, 75% 30%, 79% 28.4%, 85% 28.6%, 89% 31%, 91% 35.4%, 90% 41.3%, 91% 45.7%, 85% 55.2%, 80% 59%, 68% 57.2%, 59% 54.5%);
  transform-origin: 73% 44%;
  animation: palace-seal-drop 450ms 180ms cubic-bezier(.46, .03, .9, .58) both, palace-stamp-clear 160ms 630ms ease-out forwards;
}
.palace-flash, .palace-ring { position: absolute; pointer-events: none; }
.palace-flash { inset: 0; background: radial-gradient(ellipse at 49% 68%, #FFF5CAA8, transparent 49%); animation: palace-contact-flash 380ms 630ms ease-out both; }
.palace-ring { left: 49%; top: 68%; width: 67%; height: 26%; border: 2rpx solid #FFE7A3; border-radius: 50%; box-shadow: 0 0 16rpx #F4CB78; animation: palace-ring-out 470ms 630ms ease-out both; }
.palace-dust { position: absolute; inset: 0; pointer-events: none; }
.palace-dust > view { position: absolute; left: 49%; top: 68%; width: 7rpx; height: 5rpx; border-radius: 1rpx; background: #FFDB79; box-shadow: 0 0 10rpx #FFD368; animation: palace-dust-out 460ms 630ms ease-out both; }
.palace-dust > view:nth-child(1) { --dust-x: -105rpx; --dust-y: -40rpx; }
.palace-dust > view:nth-child(2) { --dust-x: -67rpx; --dust-y: -82rpx; }
.palace-dust > view:nth-child(3) { --dust-x: 45rpx; --dust-y: -88rpx; }
.palace-dust > view:nth-child(4) { --dust-x: 114rpx; --dust-y: -32rpx; }
.palace-dust > view:nth-child(5) { --dust-x: 90rpx; --dust-y: 41rpx; }
.palace-dust > view:nth-child(6) { --dust-x: -90rpx; --dust-y: 52rpx; }
.palace-paper .seal-result { margin-top: 20rpx; animation-delay: 990ms; }
.palace-paper .seal-result-title { color: #FFF0CB; }
.palace-paper .seal-result-note { margin: 6rpx 0 15rpx; color: #E2CFAB; }
.palace-paper .seal-return { max-width: 470rpx; margin: 0 auto; background: #E9CD89; color: #473621; }
.palace-paper .seal-close { color: #E2CFAB; min-height: 60rpx; }
@keyframes palace-card-rise {
  from { opacity: 0; transform: translateY(30rpx) scale(.93); }
  to { opacity: 1; transform: none; }
}
@keyframes palace-seal-drop {
  from { opacity: 0; transform: translate(3%, -43%) scale(1.12) rotate(-8deg); }
  22% { opacity: 1; }
  to { opacity: 1; transform: translate(-13%, 14%) scale(.97) rotate(-7deg); }
}
@keyframes palace-reveal { from { opacity: 0; } to { opacity: 1; } }
@keyframes palace-stamp-clear { from { opacity: 1; } to { opacity: 0; } }
@keyframes palace-contact-flash { 0% { opacity: 0; } 18% { opacity: .9; } 100% { opacity: 0; } }
@keyframes palace-ring-out {
  from { opacity: .85; transform: translate(-50%, -50%) scale(.33); }
  to { opacity: 0; transform: translate(-50%, -50%) scale(1.25); }
}
@keyframes palace-dust-out {
  from { opacity: 0; transform: rotate(22deg) scale(.65); }
  20% { opacity: .96; }
  to { opacity: 0; transform: translate(var(--dust-x), var(--dust-y)) rotate(148deg) scale(.4); }
}
@keyframes seal-strike {
  0% { opacity: 0; transform: translateY(-85rpx) scale(1.28) rotate(-13deg); }
  70% { opacity: 1; transform: translateY(0) scale(.97) rotate(-7deg); box-shadow: 0 0 0 12rpx rgba(161, 74, 54, .14); }
  100% { opacity: 1; transform: translateY(0) scale(1) rotate(-7deg); box-shadow: 0 0 0 22rpx rgba(161, 74, 54, 0); }
}
@keyframes seal-result { from { opacity: 0; visibility: hidden; } to { opacity: 1; visibility: visible; } }
@media (prefers-reduced-motion: reduce) {
  .seal-imprint, .seal-result, .palace-stage, .palace-reveal { animation: none; }
  .palace-stamp, .palace-flash, .palace-ring, .palace-dust { display: none; }
}
