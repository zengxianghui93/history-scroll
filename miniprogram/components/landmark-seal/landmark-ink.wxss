  background: radial-gradient(ellipse at 32% 20%, #AE4A39, #8E3328 74%);
  color: #FFE3B4; box-shadow: inset 0 0 0 .09em #843227; font: 700 39rpx/1 "Songti SC", "SimSun", serif;
}
