{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "allowJs": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["miniprogram-api-typings"],
    "lib": ["ES2020"]
  },
  "include": ["miniprogram/**/*.ts", "typings/**/*.d.ts"]
}
